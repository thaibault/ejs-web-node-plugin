{
  "name": "ejs-web-node-plugin",
  "version": "1.0.439",
  "description": "A static template processor for web-node.",
  "keywords": [
    "backend",
    "ejs",
    "static",
    "template"
  ],
  "homepage": "https://tsickert.com/ejs-web-node-plugin",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/ejs-web-node-plugin/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/ejs-web-node-plugin.git"
  },
  "main": "index.js",
  "type": "module",
  "files": [
    "index.d.ts",
    "index.js",
    "type.d.ts"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "weboptimizer build:types && weboptimizer build",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear && rimraf dummyPlugin/dummy.txt",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "yarn build && yarn start",
    "start": "web-node '{plugin: {hotReloading: true}}'",
    "test": "yarn clear && weboptimizer test",
    "test:coverage": "yarn clear && weboptimizer test:coverage",
    "test:coverage:report": "yarn clear && weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "dependencies": {
    "ejs": "^7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.11",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "clientnode": "^4.0.1533",
    "core-js": "^3.51.0",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.5.6",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "rimraf": "^6.1.4",
    "typescript-eslint": "^8.74.0",
    "web-documentation": "^2.0.0",
    "web-node": "^1.0.644",
    "weboptimizer": "^4.0.126"
  },
  "peerDependencies": {
    "clientnode": "*",
    "core-js": "*",
    "web-node": "*"
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webNode": {
    "ejs": {
      "cache": false,
      "cacheInPlaceReplacements": false,
      "extensions": [
        ".html.js",
        ".ejs"
      ],
      "locations": {
        "exclude": [
          "backup",
          "database",
          "log",
          "mockup",
          "node_modules",
          "src",
          "source"
        ],
        "include": [],
        "inPlaceReplacements": []
      },
      "options": {
        "_with": false,
        "async": true,
        "cache": true,
        "compileDebug": {
          "__evaluate__": "self.debug"
        },
        "debug": {
          "__evaluate__": "self.debug"
        },
        "localsName": "_",
        "strict": true
      },
      "reloadEntryFiles": true,
      "reloadSourceContent": true,
      "renderAfterConfigurationUpdates": false,
      "scope": {
        "async_evaluation": {},
        "evaluation": {
          "array": "array",
          "configuration": "configuration",
          "datetime": "datetime",
          "fileSystem": "fileSystem",
          "fileSystemUtility": "fileSystemUtility",
          "functions": "functions",
          "indicators": "indicators",
          "logger": "logger",
          "module": "module",
          "now": "now",
          "nowUTCTimestamp": "nowUTCTimestamp",
          "number": "number",
          "object": "object",
          "parser": "parser",
          "path": "path",
          "pluginAPI": "pluginAPI",
          "plugins": "plugins",
          "string": "string",
          "utility": "utility"
        },
        "async_execution": {},
        "execution": {},
        "plain": {}
      }
    }
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ]
  },
  "webOptimizer": {
    "targetTechnology": {
      "boilerplate": "node",
      "payload": "node"
    }
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
