{
  "name": "ejs-web-node-plugin",
  "version": "1.0.421",
  "description": "A static template processor for web-node.",
  "keywords": [
    "backend",
    "ejs",
    "static",
    "template"
  ],
  "homepage": "https://torben.website/ejs-web-node-plugin",
  "bugs": {
    "email": "info@torben.website",
    "url": "https://github.com/thaibault/ejs-web-node-plugin/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "name": "Torben Sickert",
    "email": "info@torben.website",
    "url": "https://torben.website"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "type.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/ejs-web-node-plugin.git"
  },
  "scripts": {
    "build": "weboptimizer build:types && weboptimizer build",
    "check": "yarn check:types; yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear && rimraf dummyPlugin/dummy.txt",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "yarn build && yarn start",
    "start": "web-node '{plugin: {hotReloading: true}}'",
    "test": "yarn clear && weboptimizer test",
    "test:coverage": "yarn clear && weboptimizer test:coverage",
    "test:coverage:report": "yarn clear && weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "dependencies": {
    "ejs": "^6.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.1.2",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "clientnode": "^4.0.1482",
    "eslint": "^10.8.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.5",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.65.0",
    "web-documentation": "^1.0.45",
    "web-node": "^1.0.584",
    "weboptimizer": "^4.0.48"
  },
  "peerDependencies": {
    "clientnode": "*",
    "web-node": "*"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11",
    "yarn": ">=4"
  },
  "type": "module",
  "resolutions": {
    "colors": "1.4.0",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "sideEffects": true,
  "webDocumentation": {
    "trackingCode": "UA-40192634-19"
  },
  "webNode": {
    "ejs": {
      "cache": false,
      "cacheInPlaceReplacements": false,
      "extensions": [
        ".html.js",
        ".ejs"
      ],
      "locations": {
        "exclude": [
          "backup",
          "database",
          "log",
          "mockup",
          "node_modules",
          "src",
          "source"
        ],
        "include": [],
        "inPlaceReplacements": []
      },
      "options": {
        "async": true,
        "cache": true,
        "compileDebug": {
          "__evaluate__": "self.debug"
        },
        "debug": {
          "__evaluate__": "self.debug"
        },
        "localsName": "_",
        "strict": true,
        "_with": false
      },
      "renderAfterConfigurationUpdates": false,
      "reloadEntryFiles": true,
      "reloadSourceContent": true,
      "scope": {
        "evaluation": {
          "array": "array",
          "configuration": "configuration",
          "datetime": "datetime",
          "fileSystem": "fileSystem",
          "fileSystemUtility": "fileSystemUtility",
          "functions": "functions",
          "indicators": "indicators",
          "logger": "logger",
          "module": "module",
          "now": "now",
          "nowUTCTimestamp": "nowUTCTimestamp",
          "number": "number",
          "object": "object",
          "parser": "parser",
          "path": "path",
          "pluginAPI": "pluginAPI",
          "plugins": "plugins",
          "string": "string",
          "utility": "utility"
        },
        "execution": {},
        "plain": {}
      }
    }
  },
  "webOptimizer": {
    "targetTechnology": {
      "boilerplate": "node",
      "payload": "node"
    }
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
